<Window x:Class="Blatja.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:Blatja.App.Controls"
        xmlns:s="clr-namespace:Blatja.App.Shell"
        Title="Blatja Tweaks" Width="1280" Height="820" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/icon.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static s:Commands.RunOp}" Executed="RunOp_Executed" CanExecute="RunOp_CanExecute"/>
    </Window.CommandBindings>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" TextElement.Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════ Barre latérale ═════════ -->
            <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid Margin="14,18,14,14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel x:Name="Brand" Orientation="Horizontal" Background="Transparent" Margin="8,2,0,22">
                        <Polygon Points="14,0 2,15 9,15 6,28 20,10 12,10" Fill="{StaticResource Accent}" Width="18" Height="26" Stretch="Fill"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BLATJA" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="Optimisation Windows" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <TextBlock Text="ACCUEIL" Style="{StaticResource Txt.Overline}" Margin="12,0,0,6"/>
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" Content="Dashboard" c:Ui.Icon="{StaticResource IconDashboard}" IsChecked="True"/>
                            <RadioButton x:Name="NavMonitoring" Style="{StaticResource NavItem}" GroupName="Nav" Content="Monitoring" c:Ui.Icon="{StaticResource IconActivity}"/>
                            <RadioButton x:Name="NavAuto" Style="{StaticResource NavItem}" GroupName="Nav" Content="Analyse et optimisation" c:Ui.Icon="{StaticResource IconScan}"/>

                            <TextBlock Text="OPTIMISATION" Style="{StaticResource Txt.Overline}" Margin="12,12,0,4"/>
                            <RadioButton x:Name="NavGaming" Style="{StaticResource NavItem}" GroupName="Nav" Content="Gaming" c:Ui.Icon="{StaticResource IconGamepad}"/>
                            <RadioButton x:Name="NavCpu" Style="{StaticResource NavItem}" GroupName="Nav" Content="CPU et processeur" c:Ui.Icon="{StaticResource IconCpu}"/>
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="Nav" Content="GPU et pilotes" c:Ui.Icon="{StaticResource IconGpu}"/>
                            <RadioButton x:Name="NavMemory" Style="{StaticResource NavItem}" GroupName="Nav" Content="RAM et processus" ToolTip="Mémoire et processus" c:Ui.Icon="{StaticResource IconRam}"/>
                            <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}" GroupName="Nav" Content="Réseau et latence" c:Ui.Icon="{StaticResource IconNetwork}"/>
                            <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}" GroupName="Nav" Content="Stockage et démarrage" c:Ui.Icon="{StaticResource IconStorage}"/>
                            <RadioButton x:Name="NavDebloat" Style="{StaticResource NavItem}" GroupName="Nav" Content="Windows Debloat" c:Ui.Icon="{StaticResource IconTrash}"/>

                            <TextBlock Text="OUTILS" Style="{StaticResource Txt.Overline}" Margin="12,12,0,4"/>
                            <RadioButton x:Name="NavUtilities" Style="{StaticResource NavItem}" GroupName="Nav" Content="Utilitaires système" c:Ui.Icon="{StaticResource IconWrench}"/>

                            <TextBlock Text="SÉCURITÉ" Style="{StaticResource Txt.Overline}" Margin="12,12,0,4"/>
                            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" Content="Historique" ToolTip="Historique des modifications" c:Ui.Icon="{StaticResource IconJournal}"/>
                            <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" GroupName="Nav" Content="Points de restauration" c:Ui.Icon="{StaticResource IconHistory}"/>

                            <TextBlock Text="PARAMÈTRES" Style="{StaticResource Txt.Overline}" Margin="12,12,0,4"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Content="Paramètres" c:Ui.Icon="{StaticResource IconSettings}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource SurfaceHi}">
                        <StackPanel>
                            <TextBlock x:Name="SideWindows" Text="Windows" Style="{StaticResource Txt.Caption}" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SideSummary" Text="" Style="{StaticResource Txt.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═════════ Zone principale ═════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- Barre supérieure -->
                <Border x:Name="TopBar" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,10,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource Txt.H2}"/>
                            <Border x:Name="StatusPill" Style="{StaticResource Badge}" Margin="14,0,0,0" Padding="9,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="Prêt" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LastRefresh" Text="" Style="{StaticResource Txt.Caption}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Heure de la dernière mesure système"/>
                            <Border x:Name="AdminChip" Style="{StaticResource Badge.Success}" Padding="9,3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="AdminIcon" Data="{StaticResource IconShield}" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="AdminText" Text="Administrateur" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnElevate" Style="{StaticResource Btn.Secondary}" Content="Relancer en administrateur" Padding="12,4" FontSize="12" MinHeight="28" Margin="0,0,8,0" Visibility="Collapsed"
                                    ToolTip="Nécessaire pour modifier le système. L'analyse et le monitoring fonctionnent sans."/>
                            <Button x:Name="BtnSettings" Style="{StaticResource Btn.Icon}" c:Ui.Icon="{StaticResource IconSettings}" ToolTip="Paramètres" AutomationProperties.Name="Paramètres"/>
                            <Button x:Name="BtnMin" Style="{StaticResource Btn.Icon}" c:Ui.Icon="{StaticResource IconMinimize}" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
                            <Button x:Name="BtnClose" Style="{StaticResource Btn.Icon}" c:Ui.Icon="{StaticResource IconClose}" ToolTip="Fermer" AutomationProperties.Name="Fermer"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False"/>
            </Grid>

            <!-- ═════════ Notifications ═════════ -->
            <Border x:Name="Toast" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="460"
                    Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="16,12"
                    Opacity="0" IsHitTestVisible="False" Panel.ZIndex="40" AutomationProperties.LiveSetting="Polite">
                <Border.RenderTransform><TranslateTransform x:Name="ToastSlide" Y="12"/></Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,2,12,0"/>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="390" Style="{StaticResource Txt.Body}"/>
                </StackPanel>
            </Border>

            <!-- ═════════ Dialogues (confirmation, choix) ═════════ -->
            <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed" Panel.ZIndex="50">
                <Border x:Name="DialogCard" Style="{StaticResource Card}" Width="580" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"/>
            </Grid>

            <!-- ═════════ Exécution et rapport ═════════ -->
            <Grid x:Name="RunLayer" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed" Panel.ZIndex="60">
                <Border Style="{StaticResource Card}" Width="720" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" BorderBrush="{StaticResource BorderStrong}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="24,22,24,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="RunTitle" Text="Exécution" Style="{StaticResource Txt.H2}"/>
                                <TextBlock x:Name="RunSubtitle" Text="" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <c:Spinner x:Name="RunSpinner" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,20,0">
                            <StackPanel>
                                <ProgressBar x:Name="RunBar" Style="{StaticResource Bar}" Height="5" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RunSteps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Txt.Caption}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="RunResult" Visibility="Collapsed" Margin="0,10,0,6">
                                    <Border Style="{StaticResource Divider}" Margin="0,0,0,14"/>
                                    <WrapPanel x:Name="RunBadges" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="RunNotice" Style="{StaticResource Txt.Body}" Foreground="{StaticResource Warning}" Margin="0,0,0,12"/>
                                    <TextBlock Text="AVANT / APRÈS" Style="{StaticResource Txt.Overline}" x:Name="CompareTitle"/>
                                    <Grid x:Name="CompareHead" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Mesure" Style="{StaticResource Txt.Caption}"/>
                                        <TextBlock Grid.Column="1" Text="Avant" Style="{StaticResource Txt.Caption}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Après" Style="{StaticResource Txt.Caption}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="Écart" Style="{StaticResource Txt.Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" Margin="0,6,0,0"/>
                                    <ItemsControl x:Name="CompareRows" Margin="0,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Row}" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Txt.Body}"/>
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Txt.Caption}" FontSize="11.5"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Txt.Mono}" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding After}" Style="{StaticResource Txt.Mono}" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource Txt.Mono}" HorizontalAlignment="Right" Foreground="{StaticResource Text2}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="CompareNote" Style="{StaticResource Txt.Caption}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Padding="24,14" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RunCancel" Style="{StaticResource Btn.Secondary}" Content="Arrêter après l'opération en cours" Margin="0,0,8,0"/>
                                <Button x:Name="RunJournal" Style="{StaticResource Btn.Secondary}" Content="Voir l'historique" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <Button x:Name="RunClose" Style="{StaticResource Btn.Primary}" Content="Fermer" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
