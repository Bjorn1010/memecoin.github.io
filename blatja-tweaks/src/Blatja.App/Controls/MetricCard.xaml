<UserControl x:Class="Blatja.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Blatja.App.Controls" Focusable="False">
    <Border Style="{StaticResource Card}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="LabelText" Style="{StaticResource Txt.Overline}" VerticalAlignment="Center"/>
                <Path x:Name="Ico" Fill="{StaticResource Text3}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="ValueText" Grid.Row="1" Margin="0,8,0,0"/>
            <TextBlock x:Name="SubText" Grid.Row="2" Style="{StaticResource Txt.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <ProgressBar x:Name="Bar" Grid.Row="3" Style="{StaticResource Bar}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
