<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Blatja.App.Controls"
                    xmlns:s="clr-namespace:Blatja.App.Shell">

    <!-- Badge d'état d'une optimisation : le style dépend de l'état réel -->
    <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="success"><Setter Property="Background" Value="{StaticResource SuccessSoft}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/></DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="warning"><Setter Property="Background" Value="{StaticResource WarningSoft}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/></DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="danger"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="TextElement.Foreground" Value="{StaticResource Danger}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Carte d'optimisation : nom, état RÉEL détecté, description, impact, risques, commande d'application/restauration -->
    <DataTemplate x:Key="OpCardTemplate">
        <Border Style="{StaticResource OpCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="Sel" Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,16,0"
                          IsEnabled="{Binding CanApply}" ToolTip="Inclure cette optimisation dans « Appliquer les changements sélectionnés »"
                          AutomationProperties.Name="{Binding Name}"/>

                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.H3}" Margin="0,0,10,4" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource StateBadge}" Margin="0,0,6,4"><TextBlock Text="{Binding StateText}"/></Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" ToolTip="Impact potentiel sur les performances (non garanti, dépend de la machine)">
                            <TextBlock><Run Text="Impact "/><Run Text="{Binding ImpactText, Mode=OneWay}"/></TextBlock>
                        </Border>
                        <Border Style="{StaticResource Badge.Warning}" Margin="0,0,6,4" Visibility="{Binding HasRestart, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding RestartText}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Txt.Caption}" FontSize="12.5" LineHeight="18"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Warning}" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Txt.Caption}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton x:Name="More" Content="Détails et inconvénients" Margin="0,8,0,0" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Chev" Data="{StaticResource IconChevron}" Fill="{StaticResource Text3}" Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource Text3}" Margin="6,0,0,0" x:Name="Lbl"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Border Background="#0F1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,8,0,0"
                            Visibility="{Binding IsChecked, ElementName=More, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="EFFET RÉEL SUR WINDOWS" Style="{StaticResource Txt.Overline}"/>
                            <TextBlock Text="{Binding Effect}" Style="{StaticResource Txt.Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{StaticResource Text2}"/>
                            <TextBlock Text="INCONVÉNIENTS POSSIBLES" Style="{StaticResource Txt.Overline}"/>
                            <TextBlock Text="{Binding Drawbacks}" Style="{StaticResource Txt.Caption}" FontSize="12.5" Margin="0,4,0,10"/>
                            <TextBlock Style="{StaticResource Txt.Caption}">
                                <Run Text="Risque : "/><Run Text="{Binding RiskText, Mode=OneWay}"/>
                                <Run Text="   ·   Restauration : valeurs d'origine sauvegardées avant modification"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Top" MinWidth="104">
                    <Button x:Name="Act" Content="{Binding ActionText}" Style="{StaticResource Btn.Secondary}" Padding="14,6"
                            Command="{x:Static s:Commands.RunOp}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name}"/>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                <Setter TargetName="Act" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CanApply}" Value="False"/>
                    <Condition Binding="{Binding CanRevert}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Act" Property="IsEnabled" Value="False"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- En-tête de groupe -->
    <DataTemplate x:Key="GroupHeader">
        <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Overline}" Margin="2,18,0,10"/>
    </DataTemplate>
</ResourceDictionary>
