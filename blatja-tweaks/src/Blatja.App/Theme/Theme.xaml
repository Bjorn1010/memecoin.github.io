<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════ Couleurs : graphite + un seul accent ═══════ -->
    <Color x:Key="C.Bg">#090A0D</Color>
    <Color x:Key="C.Sidebar">#0D0F13</Color>
    <Color x:Key="C.Surface">#14171D</Color>
    <Color x:Key="C.SurfaceHi">#1B1F27</Color>
    <Color x:Key="C.SurfaceHover">#222732</Color>
    <Color x:Key="C.Border">#232832</Color>
    <Color x:Key="C.BorderStrong">#333A47</Color>
    <Color x:Key="C.Text">#ECEDEF</Color>
    <Color x:Key="C.Text2">#9BA1AD</Color>
    <Color x:Key="C.Text3">#7C8492</Color>
    <Color x:Key="C.Accent">#FF5C50</Color>
    <Color x:Key="C.AccentHover">#FF766B</Color>
    <Color x:Key="C.AccentPressed">#E54A3F</Color>
    <Color x:Key="C.Success">#3DBE7A</Color>
    <Color x:Key="C.Warning">#E8A33D</Color>
    <Color x:Key="C.Danger">#E5484D</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="{StaticResource C.SurfaceHi}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource C.BorderStrong}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Text2" Color="{StaticResource C.Text2}"/>
    <SolidColorBrush x:Key="Text3" Color="{StaticResource C.Text3}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource C.Warning}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#26FF5C50"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#243DBE7A"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#26E8A33D"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26E5484D"/>
    <SolidColorBrush x:Key="Scrim" Color="#CC050608"/>

    <!-- ═══════ Typographie ═══════ -->
    <FontFamily x:Key="Font.Body">pack://application:,,,/Fonts/#Poppins</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Fonts/#Share Tech Mono</FontFamily>

    <!-- ═══════ Espacements (grille de 4) ═══════ -->
    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Pad.Row">16,12</Thickness>
    <CornerRadius x:Key="Radius.M">10</CornerRadius>
    <CornerRadius x:Key="Radius.S">8</CornerRadius>
    <CornerRadius x:Key="Radius.XS">6</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Txt.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Txt.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Txt.H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Txt.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Txt.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Txt.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    </Style>
    <Style x:Key="Txt.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Txt.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- ═══════ Surfaces ═══════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Card}"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Border}"/>
    </Style>

    <!-- Badges : le texte hérite la couleur du badge -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XS}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Badge.Success" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/>
    </Style>
    <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource WarningSoft}"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/>
    </Style>
    <Style x:Key="Badge.Danger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}"/>
    </Style>
    <Style x:Key="Badge.Accent" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <!-- Info-bulle -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <ContentPresenter TextElement.Foreground="{StaticResource Text}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barre de défilement fine -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#2A303B" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anneau de focus clavier -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="9" Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
