<s:PageBase x:Class="Blatja.App.Views.DashboardView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,18,24">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="Welcome" Text="Dashboard" Style="{StaticResource Txt.H1}"/>
                    <TextBlock Text="Mesures réelles de ton PC, mises à jour en continu." Style="{StaticResource Txt.Caption}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="BtnScan" Content="Lancer l'analyse" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource IconScan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Columns="3" x:Name="Cards">
                <c:MetricCard x:Name="CardCpu" Margin="0,0,12,12"/>
                <c:MetricCard x:Name="CardGpu" Margin="6,0,6,12"/>
                <c:MetricCard x:Name="CardRam" Margin="12,0,0,12"/>
                <c:MetricCard x:Name="CardTemp" Margin="0,0,12,0"/>
                <c:MetricCard x:Name="CardDisk" Margin="6,0,6,0"/>
                <c:MetricCard x:Name="CardNet" Margin="12,0,0,0"/>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Historique des mesures" Style="{StaticResource Txt.H2}"/>
                            <TextBlock x:Name="ChartSub" Style="{StaticResource Txt.Caption}" Margin="0,2,0,10"/>
                            <WrapPanel>
                                <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SerCpu" Style="{StaticResource Segment}" GroupName="Ser" Content="CPU" IsChecked="True"/>
                                        <RadioButton x:Name="SerGpu" Style="{StaticResource Segment}" GroupName="Ser" Content="GPU"/>
                                        <RadioButton x:Name="SerRam" Style="{StaticResource Segment}" GroupName="Ser" Content="RAM"/>
                                        <RadioButton x:Name="SerNet" Style="{StaticResource Segment}" GroupName="Ser" Content="Réseau"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Per1" Style="{StaticResource Segment}" GroupName="Per" Content="1 min" IsChecked="True"/>
                                        <RadioButton x:Name="Per5" Style="{StaticResource Segment}" GroupName="Per" Content="5 min"/>
                                        <RadioButton x:Name="Per15" Style="{StaticResource Segment}" GroupName="Per" Content="15 min"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                        <c:LiveChart x:Name="Chart" Grid.Row="1" MinHeight="250" Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Centre d'action" Style="{StaticResource Txt.H2}"/>
                            <c:Spinner x:Name="ActionSpin" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Text="Constats basés sur les mesures actuelles." Style="{StaticResource Txt.Caption}" Margin="0,2,0,12"/>
                        <ItemsControl x:Name="Findings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,10">
                                        <StackPanel>
                                            <Border Style="{Binding BadgeStyle}" HorizontalAlignment="Left" Padding="7,1"><TextBlock Text="{Binding KindText}" FontSize="11.5"/></Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Txt.Body}" FontWeight="Medium" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Txt.Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FindingsEmpty" Style="{StaticResource Txt.Caption}" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnAllFindings" Content="Ouvrir l'analyse complète" Style="{StaticResource Btn.Secondary}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Applications les plus gourmandes" Style="{StaticResource Txt.H2}"/>
                        <TextBlock Text="Triées par mémoire utilisée, regroupées par application." Style="{StaticResource Txt.Caption}" Margin="0,2,0,8"/>
                        <ItemsControl x:Name="TopProcs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource Txt.Mono}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Cpu}" Style="{StaticResource Txt.Mono}" HorizontalAlignment="Right" Foreground="{StaticResource Text2}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ProcsEmpty" Text="Lecture des processus…" Style="{StaticResource Txt.Caption}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dernières actions" Style="{StaticResource Txt.H2}"/>
                        <TextBlock Text="Modifications réellement effectuées par Blatja." Style="{StaticResource Txt.Caption}" Margin="0,2,0,8"/>
                        <ItemsControl x:Name="Recent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OpName}" Style="{StaticResource Txt.Body}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Txt.Caption}"><Run Text="{Binding Time, StringFormat='{}{0:dd/MM HH:mm}', Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="10,0,0,0"><TextBlock Text="{Binding Outcome}" FontSize="12"/></Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RecentEmpty" Text="Aucune modification effectuée pour l'instant." Style="{StaticResource Txt.Caption}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</s:PageBase>
