<s:PageBase x:Class="Blatja.App.Views.UtilitiesView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,18,24">
        <StackPanel>
            <TextBlock Text="Utilitaires système" Style="{StaticResource Txt.H1}"/>
            <TextBlock Text="Dépannages ponctuels. Contrairement aux optimisations, ces actions ne sont pas réversibles : chacune demande une confirmation et est inscrite dans l'historique." Style="{StaticResource Txt.Caption}" FontSize="13" Margin="0,3,0,18"/>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.H3}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Txt.Caption}" Margin="0,5,0,0" LineHeight="18"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Badge.Warning}" Margin="0,0,6,0" Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVis}}"><TextBlock Text="Confirmation requise"/></Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"><TextBlock Text="Administrateur"/></Border>
                                    </WrapPanel>
                                </StackPanel>
                                <Button Grid.Row="1" Content="Lancer" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Run_Click" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</s:PageBase>
