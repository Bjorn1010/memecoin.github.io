<s:PageBase x:Class="Blatja.App.Views.AutoView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,18,24">
        <StackPanel>
            <TextBlock Text="Analyse et optimisation" Style="{StaticResource Txt.H1}"/>
            <TextBlock Text="Analyse sans modification, diagnostic priorisé, plan que tu valides, puis exécution vérifiée avec rapport." Style="{StaticResource Txt.Caption}" FontSize="13" Margin="0,3,0,18"/>

            <!-- Étapes -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
                <UniformGrid Columns="5" x:Name="Stepper">
                    <StackPanel Orientation="Horizontal" x:Name="S1"><Border Width="26" Height="26" CornerRadius="13" x:Name="D1" Background="{StaticResource SurfaceHi}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Scan" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="L1"/></StackPanel>
                    <StackPanel Orientation="Horizontal" x:Name="S2"><Border Width="26" Height="26" CornerRadius="13" x:Name="D2" Background="{StaticResource SurfaceHi}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Diagnostic" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="L2"/></StackPanel>
                    <StackPanel Orientation="Horizontal" x:Name="S3"><Border Width="26" Height="26" CornerRadius="13" x:Name="D3" Background="{StaticResource SurfaceHi}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Plan" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="L3"/></StackPanel>
                    <StackPanel Orientation="Horizontal" x:Name="S4"><Border Width="26" Height="26" CornerRadius="13" x:Name="D4" Background="{StaticResource SurfaceHi}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Exécution" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="L4"/></StackPanel>
                    <StackPanel Orientation="Horizontal" x:Name="S5"><Border Width="26" Height="26" CornerRadius="13" x:Name="D5" Background="{StaticResource SurfaceHi}"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="Rapport" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="L5"/></StackPanel>
                </UniformGrid>
            </Border>

            <!-- Accueil -->
            <Border x:Name="PanelIdle" Style="{StaticResource Card}" Padding="26">
                <StackPanel>
                    <TextBlock Text="Prêt à analyser ton système" Style="{StaticResource Txt.H2}"/>
                    <TextBlock Style="{StaticResource Txt.Body}" Foreground="{StaticResource Text2}" Margin="0,8,0,0" LineHeight="20"
                               Text="L'analyse est entièrement non destructive : elle lit l'état de Windows, les programmes de démarrage, les processus, l'espace disque et la mémoire. Rien n'est modifié sans ton accord."/>
                    <Button x:Name="BtnStart" Content="Lancer l'analyse" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource IconScan}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- Scan en cours -->
            <Border x:Name="PanelScan" Style="{StaticResource Card}" Padding="26" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><c:Spinner Margin="0,0,12,0"/><TextBlock x:Name="ScanLabel" Style="{StaticResource Txt.H3}" VerticalAlignment="Center"/></StackPanel>
                    <ProgressBar x:Name="ScanBar" Style="{StaticResource Bar}" Height="6" Margin="0,16,0,0"/>
                    <TextBlock x:Name="ScanDetail" Style="{StaticResource Txt.Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Résultats -->
            <Grid x:Name="PanelResults" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Diagnostic" Style="{StaticResource Txt.H2}"/>
                        <TextBlock x:Name="DiagSub" Style="{StaticResource Txt.Caption}" Margin="0,2,0,10"/>
                        <ItemsControl x:Name="Findings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,12">
                                        <StackPanel>
                                            <Border Style="{Binding BadgeStyle}" HorizontalAlignment="Left" Padding="7,1"><TextBlock Text="{Binding KindText}" FontSize="11.5"/></Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Txt.Body}" FontWeight="Medium" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Txt.Caption}" Margin="0,5,0,0" LineHeight="17"/>
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0" Foreground="{StaticResource Text3}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DiagEmpty" Style="{StaticResource Txt.Caption}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Plan d'optimisation" Style="{StaticResource Txt.H2}"/>
                        <TextBlock x:Name="PlanSub" Style="{StaticResource Txt.Caption}" Margin="0,2,0,10"/>
                        <ItemsControl x:Name="PlanList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Name}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0" LineHeight="17"/>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Txt.Caption}" Margin="0,4,0,0" Foreground="{StaticResource Text3}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PlanEmpty" Style="{StaticResource Txt.Caption}" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnRun" Content="Appliquer le plan" Style="{StaticResource Btn.Primary}"/>
                            <Button x:Name="BtnRescan" Content="Relancer l'analyse" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Avant toute modification, un résumé te sera présenté pour confirmation. Les optimisations non recommandées (effets secondaires) ne figurent pas dans ce plan." Style="{StaticResource Txt.Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</s:PageBase>
