<s:PageBase x:Class="Blatja.App.Views.OpsView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <Grid Margin="28,22,18,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,10,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Title" Style="{StaticResource Txt.H1}"/>
                <TextBlock x:Name="Sub" Style="{StaticResource Txt.Caption}" FontSize="13" Margin="0,3,24,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <c:Spinner x:Name="Spin" Margin="0,0,12,0" Visibility="Collapsed"/>
                <TextBlock x:Name="Summary" Style="{StaticResource Txt.Caption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,24">
            <StackPanel>
                <ContentPresenter x:Name="Extra" Margin="0,0,0,6"/>

                <!-- Actions globales : explicites, jamais ambiguës -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,4,0,6">
                    <WrapPanel>
                        <Button x:Name="BtnSelectRec" Content="Sélectionner les optimisations recommandées" Style="{StaticResource Btn.Secondary}" Margin="0,2,8,2"
                                ToolTip="Coche les optimisations recommandées qui ne sont pas encore appliquées. Rien n'est modifié tant que tu n'as pas confirmé."/>
                        <Button x:Name="BtnClear" Content="Tout décocher" Style="{StaticResource Btn.Ghost}" Margin="0,2,8,2"/>
                        <Button x:Name="BtnRevertAll" Content="Restaurer les paramètres par défaut" Style="{StaticResource Btn.Secondary}" Margin="0,2,8,2"
                                ToolTip="Rétablit les valeurs d'origine des optimisations actuellement appliquées sur cette page."/>
                        <Button x:Name="BtnApply" Content="Appliquer les changements sélectionnés" Style="{StaticResource Btn.Primary}" Margin="0,2,0,2"/>
                    </WrapPanel>
                </Border>

                <ItemsControl x:Name="List" ItemTemplate="{StaticResource OpCardTemplate}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}"/>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
                <TextBlock x:Name="Empty" Style="{StaticResource Txt.Caption}" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</s:PageBase>
