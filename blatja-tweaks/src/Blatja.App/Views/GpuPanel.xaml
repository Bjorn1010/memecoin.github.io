<s:PageBase x:Class="Blatja.App.Views.GpuPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource Txt.Overline}"/>
                    <TextBlock x:Name="GpuName" Text="Détection…" Style="{StaticResource Txt.H2}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="Driver" Style="{StaticResource Txt.Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnDrivers" Content="Page des pilotes NVIDIA" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
            <UniformGrid Columns="4" Margin="0,16,0,0">
                <StackPanel><TextBlock Text="UTILISATION" Style="{StaticResource Txt.Overline}"/><TextBlock x:Name="Use" Style="{StaticResource Txt.Value}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="TEMPÉRATURE" Style="{StaticResource Txt.Overline}"/><TextBlock x:Name="Temp" Style="{StaticResource Txt.Value}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="PUISSANCE" Style="{StaticResource Txt.Overline}"/><TextBlock x:Name="Power" Style="{StaticResource Txt.Value}" Margin="0,4,0,0"/><TextBlock x:Name="PowerSub" Style="{StaticResource Txt.Caption}"/></StackPanel>
                <StackPanel><TextBlock Text="VRAM" Style="{StaticResource Txt.Overline}"/><TextBlock x:Name="Vram" Style="{StaticResource Txt.Value}" Margin="0,4,0,0"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="Advice" Style="{StaticResource Txt.Caption}" Foreground="{StaticResource Warning}" Margin="0,14,0,0" Visibility="Collapsed"/>
            <Border Style="{StaticResource Divider}" Margin="0,16,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Boost de la limite de puissance" Style="{StaticResource Txt.H3}"/>
                    <TextBlock x:Name="BoostNote" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0" LineHeight="18"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBoost" Content="Booster" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnReset" Content="Rétablir" Style="{StaticResource Btn.Ghost}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</s:PageBase>
