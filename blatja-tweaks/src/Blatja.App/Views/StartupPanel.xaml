<s:PageBase x:Class="Blatja.App.Views.StartupPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Programmes au démarrage" Style="{StaticResource Txt.H2}"/>
                    <TextBlock x:Name="Sub" Style="{StaticResource Txt.Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnReload" Content="Actualiser" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource IconRefresh}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <ItemsControl x:Name="Rows" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Txt.Mono}" FontSize="11.5" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Txt.Caption}" FontSize="11.5"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Check}" Content="Actif au démarrage" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" Tag="{Binding}"
                                          VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Empty" Text="Aucun programme de démarrage détecté." Style="{StaticResource Txt.Caption}" Visibility="Collapsed" Margin="0,12,0,0"/>
            <TextBlock Text="Désactiver un programme ne le supprime pas : tu peux le réactiver ici à tout moment. L'effet est visible au prochain démarrage de Windows." Style="{StaticResource Txt.Caption}" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</s:PageBase>
