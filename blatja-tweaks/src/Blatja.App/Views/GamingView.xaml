<s:PageBase x:Class="Blatja.App.Views.GamingView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:s="clr-namespace:Blatja.App.Shell"
            xmlns:c="clr-namespace:Blatja.App.Controls">
    <s:PageBase.Resources>
        <Style x:Key="ProfileCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface}" Padding="16,14" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </s:PageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,18,24">
        <StackPanel>
            <TextBlock Text="Gaming" Style="{StaticResource Txt.H1}"/>
            <TextBlock Text="Jeux détectés sur ce PC, profils d'optimisation et mesure de stabilité réseau. Aucun gain de FPS ou de ping n'est garanti." Style="{StaticResource Txt.Caption}" FontSize="13" Margin="0,3,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Jeux -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Jeux détectés" Style="{StaticResource Txt.H2}"/>
                            <c:Spinner x:Name="GamesSpin" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Lecture des manifestes Epic, des bibliothèques Steam et de Riot." Style="{StaticResource Txt.Caption}" Margin="0,2,0,10"/>
                        <ItemsControl x:Name="Games">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Launcher}" Style="{StaticResource Txt.Caption}"/>
                                            <TextBlock Text="{Binding InstallPath}" Style="{StaticResource Txt.Mono}" FontSize="11" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="GamesEmpty" Style="{StaticResource Txt.Caption}" Visibility="Collapsed"
                                   Text="Aucun jeu détecté (Epic Games, Steam, Riot, Minecraft). Les réglages propres à un jeu ne sont proposés que s'il est installé."/>
                    </StackPanel>
                </Border>

                <!-- Profils -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Profils" Style="{StaticResource Txt.H2}" Margin="2,0,0,10"/>
                    <RadioButton x:Name="PBal" Style="{StaticResource ProfileCard}" GroupName="Prof" IsChecked="True">
                        <Grid><StackPanel><TextBlock x:Name="PBalName" Style="{StaticResource Txt.H3}"/><TextBlock x:Name="PBalSum" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0"/></StackPanel><Border x:Name="PBalBadge" Style="{StaticResource Badge.Success}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="Actif"/></Border></Grid>
                    </RadioButton>
                    <RadioButton x:Name="PGam" Style="{StaticResource ProfileCard}" GroupName="Prof">
                        <Grid><StackPanel><TextBlock x:Name="PGamName" Style="{StaticResource Txt.H3}"/><TextBlock x:Name="PGamSum" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0"/></StackPanel><Border x:Name="PGamBadge" Style="{StaticResource Badge.Success}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="Actif"/></Border></Grid>
                    </RadioButton>
                    <RadioButton x:Name="PMax" Style="{StaticResource ProfileCard}" GroupName="Prof">
                        <Grid><StackPanel><TextBlock x:Name="PMaxName" Style="{StaticResource Txt.H3}"/><TextBlock x:Name="PMaxSum" Style="{StaticResource Txt.Caption}" Margin="0,3,0,0"/></StackPanel><Border x:Name="PMaxBadge" Style="{StaticResource Badge.Success}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="Actif"/></Border></Grid>
                    </RadioButton>
                    <RadioButton x:Name="PCus" Style="{StaticResource ProfileCard}" GroupName="Prof">
                        <StackPanel><TextBlock Text="Personnalisé" Style="{StaticResource Txt.H3}"/><TextBlock Text="Choisis toi-même les optimisations parmi celles de gaming, processeur, GPU et réseau." Style="{StaticResource Txt.Caption}" Margin="0,3,0,0"/></StackPanel>
                    </RadioButton>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="IncludeTitle" Style="{StaticResource Txt.H3}"/>
                                <TextBlock x:Name="IncludeCount" Style="{StaticResource Txt.Caption}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Voici exactement ce que ce profil modifie, avec l'état réel détecté sur ton système." Style="{StaticResource Txt.Caption}" Margin="0,2,0,6"/>
                            <ItemsControl x:Name="Included_">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanApply}" Margin="0,0,12,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Txt.Body}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Txt.Caption}" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Txt.Caption}" FontSize="11.5" Foreground="{StaticResource Warning}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource StateBadge}" VerticalAlignment="Top" Margin="10,0,0,0"><TextBlock Text="{Binding StateText}"/></Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="BtnApply" Content="Appliquer ce profil" Style="{StaticResource Btn.Primary}"/>
                                <Button x:Name="BtnRevert" Content="Restaurer les valeurs d'origine" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Les profils ne modifient aucun fichier de jeu ni mécanisme anti-triche. Les optimisations non applicables à ta machine sont ignorées et signalées."
                                       Style="{StaticResource Txt.Caption}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ContentPresenter x:Name="NetHost" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</s:PageBase>
