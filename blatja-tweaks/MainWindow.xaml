<Window x:Class="BlatjaTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blatja Tweaks" Width="1060" Height="760" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/icon.png">
    <Border Margin="14" CornerRadius="18" BorderBrush="#232843" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0C15" Offset="0"/>
                <GradientStop Color="#0E1020" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>

        <Grid Margin="26,18,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BLATJA" FontSize="24" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" TWEAKS" FontSize="24" FontWeight="Light" Margin="2,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Optimisation Windows 11 / Tiny11 · Fortnite · GPU" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnMin" Style="{StaticResource BtnChrome}" Content="—"/>
                    <Button x:Name="BtnClose" Style="{StaticResource BtnChrome}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- Contenu -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Colonne gauche -->
                <StackPanel Grid.Column="0">
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CARTE GRAPHIQUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="GpuName" Text="Détection…" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GpuDetails" Text="" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"/>
                            <TextBlock x:Name="GpuStatus" Text="" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button x:Name="BtnGpuBoost" Style="{StaticResource BtnPrimary}" Content="Booster le GPU" Margin="0,16,0,0"/>
                            <Button x:Name="BtnGpuReset" Style="{StaticResource BtnGhost}" Content="Réglages d'origine" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="FORTNITE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="FnStatus" Text="Recherche…" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="FnPath" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="OUTILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <Button x:Name="BtnClean" Style="{StaticResource BtnGhost}" Content="Nettoyer les fichiers temporaires" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Liste des réglages -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Réglages" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAll" Style="{StaticResource BtnGhost}" Content="Tout activer" Padding="14,7" FontSize="12"/>
                            <Button x:Name="BtnNone" Style="{StaticResource BtnGhost}" Content="Tout désactiver" Padding="14,7" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <ItemsControl x:Name="TweakList">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="4,12,0,8"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="16,13" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <Border CornerRadius="5" Padding="6,1" Margin="10,1,0,0" Background="#1E3A2F">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Applied}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="ACTIF" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                                                    </Border>
                                                    <Border CornerRadius="5" Padding="6,1" Margin="6,1,0,0" Background="#3A2D14">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsReboot}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="REDÉMARRAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Barre d'actions -->
            <Grid Grid.Row="2" Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"
                             Background="#1A1D2E" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnRestore" Style="{StaticResource BtnGhost}" Content="Tout restaurer"/>
                    <Button x:Name="BtnApply" Style="{StaticResource BtnPrimary}" Content="Appliquer les réglages" Margin="10,0,0,0" Padding="28,11"/>
                </StackPanel>
            </Grid>

            <!-- Journal -->
            <Border Grid.Row="3" Background="#0A0B12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Height="104">
                <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="12,8" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Border>
</Window>
