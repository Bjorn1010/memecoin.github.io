<Window x:Class="BlatjaTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:BlatjaTweaks"
        Title="Blatja Tweaks" Width="1240" Height="820" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#09080A" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" RenderOptions.BitmapScalingMode="HighQuality"
        Icon="pack://application:,,,/Assets/icon.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6E6975"/>
        </Style>
        <Style x:Key="BigNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="LineHeight" Value="40"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#1B181F"/>
            <Setter Property="BorderBrush" Value="#2B2730"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1F1C23"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte d'un réglage -->
        <Style x:Key="TweakCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
                    <Setter Property="Background" Value="{StaticResource PanelHi}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="BorderBrush" Value="#5A2530"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource TweakCard}" Opacity="0">
                <Border.RenderTransform><TranslateTransform x:Name="Slide" Y="12"/></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.34">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Top">
                        <Path Data="{Binding IconPath}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="14" Margin="0,0,8,0" TextWrapping="Wrap"/>
                            <Border CornerRadius="4" Padding="6,1" Margin="0,2,6,0" Background="#1C3326" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Applied}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="ACTIF" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Good}"/>
                            </Border>
                            <Border CornerRadius="4" Padding="6,1" Margin="0,2,0,0" Background="#3A2C12" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding NeedsReboot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="REDÉMARRAGE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,5,0,0" LineHeight="17"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Top" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FixTemplate">
            <Border Style="{StaticResource TweakCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}"><Path Data="{Binding IconPath}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18"/></Border>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="190"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,12,0,14" LineHeight="17"/>
                    <Button Grid.Row="2" Style="{StaticResource BtnGhost}" Content="Lancer" Padding="22,7" HorizontalAlignment="Right" Click="Fix_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RestoreTemplate">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,12" ClipToBounds="True">
                <StackPanel>
                    <Border Height="9" Background="{Binding Color}" CornerRadius="14,14,0,0"/>
                    <StackPanel Margin="18,14,18,16">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,4,0,0" MinHeight="32" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{Binding When, StringFormat='{}{0:dd/MM/yy · HH:mm}'}" Style="{StaticResource Num}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Restaurer" Padding="18,6" HorizontalAlignment="Right" Click="RestoreItem_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BiosTemplate">
            <Border Style="{StaticResource TweakCard}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconTile}"><TextBlock Text="{Binding Number}" FontFamily="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Body}" Style="{StaticResource Sub}" Margin="0,12,0,0" LineHeight="18"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TwoCols"><UniformGrid Columns="2"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ThreeCols"><UniformGrid Columns="3"/></ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="#26222B" BorderThickness="1" Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}" Opacity="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════ Barre latérale ═════════ -->
            <Border Grid.Column="0" Background="{StaticResource SideBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="Brand" Background="Transparent" Margin="8,0,4,26">
                        <StackPanel Orientation="Horizontal">
                            <Polygon Points="14,0 2,15 9,15 6,28 20,10 12,10" Fill="{StaticResource AccentBrush}" Width="22" Height="30" Stretch="Fill"/>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BLATJA" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold" LineHeight="24" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="TWEAKING UTILITY" FontSize="8.5" FontWeight="SemiBold" Foreground="#6E6975" Margin="1,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Background="#1B181F" Padding="7,2">
                            <TextBlock Text="v2.0" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"><StackPanel>
                        <TextBlock Text="GÉNÉRAL" Style="{StaticResource Overline}" Margin="14,0,0,8"/>
                        <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True">
                            <StackPanel Orientation="Horizontal"><Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="17" Height="17"/><TextBlock Text="Accueil" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal"><Path Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="17" Height="17"/><TextBlock Text="Restauration" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFix" Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal"><Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="17" Height="17"/><TextBlock Text="Corrections" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>

                        <TextBlock Text="RÉGLAGES" Style="{StaticResource Overline}" Margin="14,18,0,8"/>
                        <StackPanel x:Name="NavTweaks"/>
                        <TextBlock Text="MATÉRIEL" Style="{StaticResource Overline}" Margin="14,18,0,8"/>
                        <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal"><Path Data="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="17" Height="17"/><TextBlock Text="Carte graphique" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBios" Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal"><Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="17" Height="17"/><TextBlock Text="BIOS" Margin="12,0,0,0"/></StackPanel>
                        </RadioButton>
                    </StackPanel></ScrollViewer>

                    <Border Grid.Row="2" CornerRadius="12" Background="#121014" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="UserInitial" Text="U" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserName" Text="Utilisateur" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ActiveCount" Text="0 / 0 réglages actifs" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═════════ Contenu ═════════ -->
            <Grid Grid.Column="1" Margin="30,16,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="#6E6975" Stretch="Uniform" Width="14" Height="14"/>
                        <TextBlock Text="›" Foreground="#4A4650" Margin="10,0,8,0" FontSize="14"/>
                        <TextBlock x:Name="PageCrumb" Text="Accueil" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnMin" Style="{StaticResource BtnChrome}" Content="—"/>
                        <Button x:Name="BtnClose" Style="{StaticResource BtnChrome}" Content="✕"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PageHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform x:Name="PageSlide" Y="0"/></Grid.RenderTransform>

                    <!-- ───── Accueil ───── -->
                    <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock x:Name="WelcomeTitle" Text="Bienvenue !" Style="{StaticResource H1}"/>
                                    <TextBlock Text="Performances, optimisation et dépannage au même endroit." Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnSysInfo" Style="{StaticResource BtnGhost}" Content="Infos système" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,8"/>
                            </Grid>

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PROCESSEUR" Style="{StaticResource Overline}"/>
                                            <TextBlock x:Name="CpuVal" Text="0%" Style="{StaticResource BigNum}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="CpuSub" Text="Utilisation CPU" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <local:RingGauge x:Name="GaugeCpu" Width="84" Height="84" HorizontalAlignment="Right" VerticalAlignment="Center" Accent="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource Overline}"/>
                                            <TextBlock x:Name="GpuVal" Text="—" Style="{StaticResource BigNum}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="GpuSub" Text="Utilisation GPU" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <local:RingGauge x:Name="GaugeGpu" Width="84" Height="84" HorizontalAlignment="Right" VerticalAlignment="Center" Accent="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="MÉMOIRE" Style="{StaticResource Overline}"/>
                                            <TextBlock x:Name="RamVal" Text="0%" Style="{StaticResource BigNum}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="RamSub" Text="Utilisation RAM" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <local:RingGauge x:Name="GaugeRam" Width="84" Height="84" HorizontalAlignment="Right" VerticalAlignment="Center" Accent="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource IconTile}" Width="34" Height="34"><Path Data="M3.5 18.5l6-6 4 4L22 6.92 20.59 5.5l-7.09 8-4-4L2 17l1.5 1.5z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16"/></Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Performances" Style="{StaticResource H2}"/>
                                                    <TextBlock x:Name="ChartSub" Text="" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Background="#0D0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="TabCpu" Style="{StaticResource Tab}" GroupName="Chart" Content="CPU" IsChecked="True"/>
                                                    <RadioButton x:Name="TabGpu" Style="{StaticResource Tab}" GroupName="Chart" Content="GPU"/>
                                                    <RadioButton x:Name="TabRam" Style="{StaticResource Tab}" GroupName="Chart" Content="RAM"/>
                                                    <RadioButton x:Name="TabTemp" Style="{StaticResource Tab}" GroupName="Chart" Content="Temp"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <local:LiveChart x:Name="Chart" Grid.Row="1" MinHeight="250" Margin="0,16,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource IconTile}" Width="34" Height="34"><Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16"/></Border>
                                                    <TextBlock Text="Mode jeu" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="GameBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Background="#26FF3B52" Padding="9,3">
                                                    <TextBlock x:Name="GameBadgeText" Text="PRÊT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Border CornerRadius="10" Background="#0D0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,11" Margin="0,16,0,0">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Jeu détecté" Style="{StaticResource Sub}"/>
                                                        <TextBlock x:Name="FnStatus" Text="Fortnite" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                                        <TextBlock x:Name="FnPath" Text="" Style="{StaticResource Sub}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="10" Background="#0D0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,11" Margin="0,8,0,0">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Préréglage actuel" Style="{StaticResource Sub}"/>
                                                        <TextBlock x:Name="PresetName" Text="Personnalisé" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="HeroCount" Text="0%" Style="{StaticResource BigNum}" FontSize="26" LineHeight="26" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Button x:Name="BtnQuick" Style="{StaticResource BtnPrimary}" Content="Appliquer la configuration" Margin="0,14,0,0"/>
                                            <Button x:Name="BtnGoSystem" Style="{StaticResource BtnGhost}" Content="Choisir moi-même" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource IconTile}" Width="34" Height="34"><Path Data="M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16"/></Border>
                                                    <TextBlock Text="Disque système" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="BtnClean" Style="{StaticResource BtnGhost}" Content="Nettoyer" HorizontalAlignment="Right" Padding="14,5" FontSize="12"/>
                                            </Grid>
                                            <TextBlock x:Name="DiskText" Text="" Style="{StaticResource Sub}" Margin="0,14,0,8"/>
                                            <ProgressBar x:Name="DiskBar" Style="{StaticResource Bar}" Height="10"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,4" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="Activité récente" Style="{StaticResource H2}"/>
                                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                                             FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="0,8,0,0" TextWrapping="Wrap" Height="88"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ───── Restauration ───── -->
                    <ScrollViewer x:Name="PageRestore" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Points de restauration" Style="{StaticResource H1}"/>
                            <TextBlock Text="Crée et restaure des points de restauration pour protéger ton système." Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="24">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}"><Path Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18"/></Border>
                                            <TextBlock Text="Créer un point de restauration" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Couleur de la bannière" Style="{StaticResource Sub}" Margin="0,20,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Sw1" Style="{StaticResource Swatch}" GroupName="Sw" Tag="#FF3B52" IsChecked="True"/>
                                            <RadioButton x:Name="Sw2" Style="{StaticResource Swatch}" GroupName="Sw" Tag="#FFB020"/>
                                            <RadioButton x:Name="Sw3" Style="{StaticResource Swatch}" GroupName="Sw" Tag="#4ADE80"/>
                                            <RadioButton x:Name="Sw4" Style="{StaticResource Swatch}" GroupName="Sw" Tag="#4DA3FF"/>
                                            <RadioButton x:Name="Sw5" Style="{StaticResource Swatch}" GroupName="Sw" Tag="#B06BFF"/>
                                        </StackPanel>
                                        <TextBox x:Name="RpName" Style="{StaticResource Field}" Text="Avant optimisation" Margin="0,16,0,0"/>
                                        <TextBox x:Name="RpDesc" Style="{StaticResource Field}" Text="Sauvegarde avant d'appliquer des réglages" Height="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,10,0,0"/>
                                        <Grid Margin="0,16,0,0">
                                            <TextBlock x:Name="RpStatus" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,140,0"/>
                                            <Button x:Name="BtnCreateRestore" Style="{StaticResource BtnPrimary}" Content="Créer  +" HorizontalAlignment="Right" Padding="26,9"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="Pourquoi créer un point ?" Style="{StaticResource H2}" FontSize="16"/>
                                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Top"><Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12"/></Border>
                                            <TextBlock Grid.Column="1" Text="Annuler les changements qui nuiraient aux performances." Style="{StaticResource Sub}" FontSize="12.5" Margin="12,2,0,0"/></Grid>
                                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Top"><Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12"/></Border>
                                            <TextBlock Grid.Column="1" Text="Protéger ta configuration en cas de coupure ou de plantage." Style="{StaticResource Sub}" FontSize="12.5" Margin="12,2,0,0"/></Grid>
                                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconTile}" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Top"><Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12"/></Border>
                                            <TextBlock Grid.Column="1" Text="Revenir à l'état d'avant quand tu veux." Style="{StaticResource Sub}" FontSize="12.5" Margin="12,2,0,0"/></Grid>
                                        <Button x:Name="BtnRestore" Style="{StaticResource BtnGhost}" Content="Annuler tous les réglages Blatja" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Catalogue" Style="{StaticResource H2}" FontSize="16" Margin="2,24,0,12"/>
                            <TextBlock x:Name="RestoreEmpty" Text="Aucun point créé par Blatja pour l'instant." Style="{StaticResource Sub}" Margin="2,0,0,0"/>
                            <ItemsControl x:Name="RestoreList" ItemTemplate="{StaticResource RestoreTemplate}" ItemsPanel="{StaticResource ThreeCols}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ───── Corrections ───── -->
                    <ScrollViewer x:Name="PageFix" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Corrections" Style="{StaticResource H1}"/>
                            <TextBlock Text="Dépannages rapides pour les problèmes courants de Windows." Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,18"/>
                            <ItemsControl x:Name="FixList" ItemTemplate="{StaticResource FixTemplate}" ItemsPanel="{StaticResource ThreeCols}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ───── Réglages ───── -->
                    <Grid x:Name="PageTweaks" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="PageTitle" Text="Système" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="PageSub" Text="" Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button x:Name="BtnAll" Style="{StaticResource BtnGhost}" Content="Tout activer" Padding="16,7" FontSize="12"/>
                                <Button x:Name="BtnNone" Style="{StaticResource BtnGhost}" Content="Tout désactiver" Padding="16,7" FontSize="12" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakTemplate}" ItemsPanel="{StaticResource TwoCols}"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ───── BIOS ───── -->
                    <ScrollViewer x:Name="PageBios" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="BIOS" Style="{StaticResource H1}"/>
                                    <TextBlock Text="Réglages à vérifier dans le BIOS/UEFI : ils ne se changent pas depuis Windows." Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnBios" Style="{StaticResource BtnPrimary}" Content="Redémarrer vers le BIOS" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,9"/>
                            </Grid>
                            <ItemsControl x:Name="BiosList" ItemsPanel="{StaticResource TwoCols}" ItemTemplate="{StaticResource BiosTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ───── Carte graphique ───── -->
                    <ScrollViewer x:Name="PageGpu" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="GpuName" Text="Carte graphique" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GpuDriver" Text="" Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,18"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PUISSANCE" Style="{StaticResource Overline}"/><TextBlock x:Name="TilePower" Text="—" Style="{StaticResource BigNum}" Margin="0,6,0,0"/><TextBlock x:Name="BarPowerLabel" Style="{StaticResource Sub}"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,6,0"><StackPanel><TextBlock Text="FRÉQUENCE BOOST MAX" Style="{StaticResource Overline}"/><TextBlock x:Name="TileClock" Text="—" Style="{StaticResource BigNum}" Margin="0,6,0,0"/><TextBlock Text="MHz maximum constructeur" Style="{StaticResource Sub}"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="TEMPÉRATURE" Style="{StaticResource Overline}"/><TextBlock x:Name="TileTemp" Text="—" Style="{StaticResource BigNum}" Margin="0,6,0,0"/><TextBlock Text="en direct" Style="{StaticResource Sub}"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Limite de puissance" Style="{StaticResource H2}"/>
                                    <ProgressBar x:Name="BarPower" Style="{StaticResource Bar}" Height="8" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="GpuStatus" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="BtnGpuBoost" Style="{StaticResource BtnPrimary}" Content="Booster le GPU" Padding="26,10"/>
                                        <Button x:Name="BtnGpuReset" Style="{StaticResource BtnGhost}" Content="Réglages d'origine" Padding="22,10" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Règle la limite de puissance au maximum et verrouille la fréquence minimale à 90 % du boost max (NVIDIA uniquement). Ce n'est pas un overclock avec tension : pour ça, utilise MSI Afterburner."
                                               Style="{StaticResource Sub}" Margin="0,16,0,0" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Barre d'actions (réglages) -->
                <Grid x:Name="ActionBar" Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock x:Name="ProgressLabel" Text="Prêt" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Height="5"/>
                    </StackPanel>
                    <Button x:Name="BtnApply" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Appliquer les réglages" Padding="32,11"/>
                </Grid>
            </Grid>

            <!-- ═════════ Notification ═════════ -->
            <Border x:Name="Toast_" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,34" MaxWidth="420"
                    Background="#1A171E" BorderBrush="#36313D" BorderThickness="1" CornerRadius="12" Padding="16,12" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="40">
                <Border.RenderTransform><TranslateTransform x:Name="ToastSlide" X="30"/></Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastText" Margin="12,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
            </Border>

            <!-- ═════════ Point de restauration obligatoire ═════════ -->
            <Grid x:Name="Gate" Grid.ColumnSpan="2" Background="#F5070608" Panel.ZIndex="50">
                <Border Style="{StaticResource Card}" Width="560" Padding="36,32" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#121014" BorderBrush="#2B2730">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Polygon Points="14,0 2,15 9,15 6,28 20,10 12,10" Fill="{StaticResource AccentBrush}" Width="18" Height="25" Stretch="Fill"/>
                            <TextBlock Text="AVANT DE COMMENCER" Style="{StaticResource Overline}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Crée un point de restauration" Style="{StaticResource H1}" FontSize="28" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GateText" Style="{StaticResource Sub}" FontSize="14" Margin="0,10,0,0" LineHeight="22"
                                   Text="Avant de modifier Windows, Blatja Tweaks crée un point de restauration. Si quoi que ce soit ne te plaît, tu pourras revenir exactement à l'état d'avant."/>
                        <TextBlock x:Name="GateStatus" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <Button x:Name="GateBtn" Style="{StaticResource BtnPrimary}" Content="Créer le point de restauration" Padding="26,12" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                        <Button x:Name="GateSkip" Style="{StaticResource BtnGhost}" Content="Continuer sans point de restauration (déconseillé)" Padding="16,7" FontSize="12" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
