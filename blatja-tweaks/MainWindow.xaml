<Window x:Class="BlatjaTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blatja Tweaks" Width="1180" Height="800" MinWidth="1000" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/icon.png">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12141F"/>
            <Setter Property="BorderBrush" Value="#1F2338"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#0D0F1B"/>
            <Setter Property="BorderBrush" Value="#1B1F33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="TweakCard" TargetType="Border">
            <Setter Property="Background" Value="#12141F"/>
            <Setter Property="BorderBrush" Value="#1F2338"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#343A5E"/>
                    <Setter Property="Background" Value="#161929"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="BorderBrush" Value="#4B3FB0"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A1840" Offset="0"/>
                                <GradientStop Color="#12141F" Offset="0.75"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource TweakCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#191C2E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <Border CornerRadius="5" Padding="6,1" Margin="10,1,0,0" Background="#12352A">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Applied}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="ACTIF" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                            </Border>
                            <Border CornerRadius="5" Padding="6,1" Margin="6,1,0,0" Background="#3A2D14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsReboot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="REDÉMARRAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,16,0" LineHeight="17"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="20" BorderBrush="#262B49" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97"/></Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0B14" Offset="0"/>
                <GradientStop Color="#0D0F1E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.75" Color="Black"/></Border.Effect>

        <Grid ClipToBounds="True">
            <!-- Lueurs d'ambiance -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-380,60,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush><GradientStop Color="#307C5CFF" Offset="0"/><GradientStop Color="#007C5CFF" Offset="1"/></RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,200,-340">
                    <Ellipse.Fill>
                        <RadialGradientBrush><GradientStop Color="#2800D4FF" Offset="0"/><GradientStop Color="#0000D4FF" Offset="1"/></RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────── Barre latérale ─────── -->
                <Border Grid.Column="0" Background="#090A12" BorderBrush="#181B2E" BorderThickness="0,0,1,0" CornerRadius="20,0,0,20">
                    <Grid Margin="16,22,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="Brand" Orientation="Horizontal" Background="Transparent" Margin="6,0,0,26">
                            <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                <Border.Effect><DropShadowEffect Color="#7C5CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                                <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BLATJA" FontSize="19" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="TWEAKS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="1,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🏠" Content="Tableau de bord" IsChecked="True"/>
                            <TextBlock Text="RÉGLAGES" Style="{StaticResource Overline}" FontSize="10" Margin="14,18,0,8"/>
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚙" Content="Système"/>
                            <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🖱" Content="Entrées &amp; réseau"/>
                            <RadioButton x:Name="NavFn" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🎮" Content="Fortnite"/>
                            <TextBlock Text="MATÉRIEL" Style="{StaticResource Overline}" FontSize="10" Margin="14,18,0,8"/>
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🖥" Content="Carte graphique"/>
                            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🧰" Content="Outils"/>
                        </StackPanel>

                        <Border Grid.Row="2" CornerRadius="14" Background="#11142A" BorderBrush="#232850" BorderThickness="1" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DotActive" Width="8" Height="8" Fill="#4A4F70" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ActiveCount" Text="0 / 0 actifs" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="ActiveBar" Style="{StaticResource Bar}" Height="4" Margin="0,9,0,0"/>
                                <TextBlock Text="v1.0 · tout est réversible" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ─────── Contenu ─────── -->
                <Grid Grid.Column="1" Margin="30,22,30,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête de page -->
                    <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Tableau de bord" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSub" Text="" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel x:Name="TweakTools" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,14,0">
                                <Button x:Name="BtnAll" Style="{StaticResource BtnGhost}" Content="Tout activer" Padding="14,7" FontSize="12" Height="30"/>
                                <Button x:Name="BtnNone" Style="{StaticResource BtnGhost}" Content="Tout désactiver" Padding="14,7" FontSize="12" Margin="8,0,0,0" Height="30"/>
                            </StackPanel>
                            <Button x:Name="BtnMin" Style="{StaticResource BtnChrome}" Content="—"/>
                            <Button x:Name="BtnClose" Style="{StaticResource BtnChrome}" Content="✕"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pages -->
                    <Grid Grid.Row="1">
                        <!-- Tableau de bord -->
                        <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <StackPanel>
                                <Border CornerRadius="20" Padding="30,26" BorderBrush="#34307A" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#231C5C" Offset="0"/>
                                            <GradientStop Color="#0F1630" Offset="0.6"/>
                                            <GradientStop Color="#0B1D2E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PERFORMANCE · FORTNITE" Style="{StaticResource Overline}" Foreground="#9C8CFF"/>
                                            <TextBlock Text="Plus de FPS, moins de latence." FontSize="28" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="Applique toutes les optimisations recommandées en un clic. Un point de restauration est créé avant, et tout peut être annulé."
                                                       FontSize="13" Foreground="#A9AFD2" TextWrapping="Wrap" Margin="0,10,40,0" LineHeight="20"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                                <Button x:Name="BtnQuick" Style="{StaticResource BtnPrimary}" Content="⚡   Optimisation recommandée" Padding="26,13" FontSize="14"/>
                                                <Button x:Name="BtnGoSystem" Style="{StaticResource BtnGhost}" Content="Choisir moi-même" Padding="22,13" Margin="12,0,0,0" FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,0">
                                            <TextBlock x:Name="HeroCount" Text="0" FontSize="64" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock x:Name="HeroCountLabel" Text="réglages actifs" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="4" Margin="-5,16,-5,0">
                                    <Border Style="{StaticResource Tile}"><StackPanel>
                                        <TextBlock x:Name="DashGpu" Text="—" Style="{StaticResource BigNum}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel>
                                        <TextBlock x:Name="DashPower" Text="—" Style="{StaticResource BigNum}"/>
                                        <TextBlock Text="PUISSANCE GPU" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel>
                                        <TextBlock x:Name="DashTemp" Text="—" Style="{StaticResource BigNum}"/>
                                        <TextBlock Text="TEMPÉRATURE" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel>
                                        <TextBlock x:Name="FnStatus" Text="…" Style="{StaticResource BigNum}"/>
                                        <TextBlock Text="FORTNITE" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                </UniformGrid>

                                <UniformGrid Columns="3" Margin="-6,16,-6,0">
                                    <Border Style="{StaticResource Card}" Margin="6,0">
                                        <StackPanel>
                                            <TextBlock Text="01" FontSize="30" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="FPS &amp; latence" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            <TextBlock Text="Plan Performances ultimes, Mode Jeu, planification GPU, minuteur système et priorités CPU." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="18"/>
                                            <Button x:Name="BtnOpenSystem" Style="{StaticResource BtnGhost}" Content="Ouvrir  →" Padding="14,8" FontSize="12" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="6,0">
                                        <StackPanel>
                                            <TextBlock Text="02" FontSize="30" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Entrées &amp; réseau" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            <TextBlock Text="Souris 1:1 sans accélération et réseau sans délai d'envoi pour une visée et un ping réguliers." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="18"/>
                                            <Button x:Name="BtnOpenInput" Style="{StaticResource BtnGhost}" Content="Ouvrir  →" Padding="14,8" FontSize="12" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="6,0">
                                        <StackPanel>
                                            <TextBlock Text="03" FontSize="30" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Fortnite" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            <TextBlock Text="Priorité CPU haute, GPU dédié, plein écran exclusif et graphismes réglés pour les FPS." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="18"/>
                                            <Button x:Name="BtnOpenFn" Style="{StaticResource BtnGhost}" Content="Ouvrir  →" Padding="14,8" FontSize="12" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock x:Name="FnPath" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Réglages (Système / Entrées / Fortnite) -->
                        <ScrollViewer x:Name="PageTweaks" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                            <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakTemplate}"/>
                        </ScrollViewer>

                        <!-- GPU -->
                        <ScrollViewer x:Name="PageGpu" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="GpuName" Text="Détection…" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GpuDriver" Text="" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        <UniformGrid Columns="3" Margin="-5,18,-5,0">
                                            <Border Style="{StaticResource Tile}"><StackPanel>
                                                <TextBlock x:Name="TilePower" Text="—" Style="{StaticResource BigNum}"/>
                                                <TextBlock Text="PUISSANCE" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                            <Border Style="{StaticResource Tile}"><StackPanel>
                                                <TextBlock x:Name="TileClock" Text="—" Style="{StaticResource BigNum}"/>
                                                <TextBlock Text="BOOST MAX" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                            <Border Style="{StaticResource Tile}"><StackPanel>
                                                <TextBlock x:Name="TileTemp" Text="—" Style="{StaticResource BigNum}"/>
                                                <TextBlock Text="TEMPÉRATURE" Style="{StaticResource TileLabel}"/></StackPanel></Border>
                                        </UniformGrid>
                                        <Grid Margin="0,20,0,0">
                                            <TextBlock Text="Limite de puissance" FontSize="12" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="BarPowerLabel" Text="" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarPower" Style="{StaticResource Bar}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="GpuStatus" Text="" FontSize="12.5" Foreground="{StaticResource Warn}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button x:Name="BtnGpuBoost" Style="{StaticResource BtnPrimary}" Content="⚡   Booster le GPU" Padding="26,12"/>
                                            <Button x:Name="BtnGpuReset" Style="{StaticResource BtnGhost}" Content="Réglages d'origine" Padding="22,12" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Le boost règle la limite de puissance au maximum et verrouille la fréquence minimale à 90 % du boost max (NVIDIA uniquement). Ce n'est pas un overclock avec tension : pour ça, utilise MSI Afterburner."
                                                   FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="17"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Outils -->
                        <ScrollViewer x:Name="PageTools" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Nettoyer les fichiers temporaires" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Supprime le contenu des dossiers Temp de l'utilisateur et de Windows." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnClean" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="🧹  Nettoyer" Padding="22,11"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Tout restaurer" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Annule tous les réglages appliqués et remet Windows dans son état d'origine." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnRestore" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="↩  Restaurer" Padding="22,11"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Barre d'actions -->
                    <Grid x:Name="ActionBar" Grid.Row="2" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock x:Name="ProgressLabel" Text="Prêt" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                            <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Height="5"/>
                        </StackPanel>
                        <Button x:Name="BtnApply" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Appliquer les réglages" Padding="34,12" FontSize="14"/>
                    </Grid>

                    <!-- Journal -->
                    <Border Grid.Row="3" Background="#080910" BorderBrush="#1B1F33" BorderThickness="1" CornerRadius="12" Height="84">
                        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#8B92B8"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="14,9" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
