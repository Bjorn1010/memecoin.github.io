<Window x:Class="BlatjaTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blatja Tweaks" Width="1160" Height="780" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/icon.png">
    <Window.Resources>
        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1D1F24"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TweakCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
                    <Setter Property="Background" Value="{StaticResource PanelHi}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="BorderBrush" Value="#566A1A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource TweakCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Repère d'état -->
                    <Border Width="3" Margin="-18,-15,16,-15" CornerRadius="8,0,0,8" Background="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Applied}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="15"/>
                            <Border CornerRadius="3" Padding="6,1" Margin="12,2,0,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Applied}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="ACTIF" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <Border CornerRadius="3" Padding="6,1" Margin="6,2,0,0" BorderBrush="{StaticResource Warn}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsReboot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="REDÉMARRAGE" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Warn}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,20,0" LineHeight="18"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="12" BorderBrush="#2A2C32" BorderThickness="1" Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="0.985" ScaleY="0.985"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" Color="Black"/></Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── Barre latérale ─────── -->
            <Border Grid.Column="0" Background="#0A0B0D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12">
                <Grid Margin="14,22,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="Brand" Orientation="Horizontal" Background="Transparent" Margin="8,0,0,30">
                        <Polygon Points="14,0 2,15 9,15 6,28 20,10 12,10" Fill="{StaticResource AccentBrush}" Width="22" Height="28" Stretch="Fill"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BLATJA" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Bold"/>
                            <TextBlock Text="TWEAKS" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="1,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" GroupName="Nav" Content="Tableau de bord" IsChecked="True"/>
                        <TextBlock Text="RÉGLAGES" Style="{StaticResource Overline}" Margin="14,22,0,8"/>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="Nav" Content="Système"/>
                        <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" GroupName="Nav" Content="Entrées &amp; réseau"/>
                        <RadioButton x:Name="NavFn" Style="{StaticResource NavItem}" GroupName="Nav" Content="Fortnite"/>
                        <TextBlock Text="MATÉRIEL" Style="{StaticResource Overline}" Margin="14,22,0,8"/>
                        <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="Nav" Content="Carte graphique"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav" Content="Outils"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="8,0,8,0">
                        <Grid>
                            <TextBlock Text="ACTIFS" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="ActiveCount" Text="0 / 0" Style="{StaticResource Num}"/>
                        </Grid>
                        <ProgressBar x:Name="ActiveBar" Style="{StaticResource Bar}" Margin="0,9,0,0"/>
                        <Ellipse x:Name="DotActive" Width="0" Height="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─────── Contenu ─────── -->
            <Grid Grid.Column="1" Margin="32,22,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Tableau de bord" FontFamily="{StaticResource Display}" FontSize="28"/>
                        <TextBlock x:Name="PageSub" Text="" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel x:Name="TweakTools" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,14,0">
                            <Button x:Name="BtnAll" Style="{StaticResource BtnGhost}" Content="Tout activer" Padding="13,0" FontSize="12" Height="28"/>
                            <Button x:Name="BtnNone" Style="{StaticResource BtnGhost}" Content="Tout désactiver" Padding="13,0" FontSize="12" Margin="6,0,0,0" Height="28"/>
                        </StackPanel>
                        <Button x:Name="BtnMin" Style="{StaticResource BtnChrome}" Content="—"/>
                        <Button x:Name="BtnClose" Style="{StaticResource BtnChrome}" Content="✕"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Tableau de bord -->
                    <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Padding="26,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CONFIGURATION RECOMMANDÉE" Style="{StaticResource Overline}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock x:Name="HeroTitle" Text="Aucun réglage appliqué" FontFamily="{StaticResource Display}" FontSize="26" Margin="0,8,0,0"/>
                                        <TextBlock Text="Active les 13 réglages d'un coup. Un point de restauration est créé avant, et chaque réglage s'annule individuellement."
                                                   FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,30,0" LineHeight="20"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button x:Name="BtnQuick" Style="{StaticResource BtnPrimary}" Content="Appliquer la configuration" Padding="24,12"/>
                                            <Button x:Name="BtnGoSystem" Style="{StaticResource BtnGhost}" Content="Choisir moi-même" Padding="20,12" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                        <TextBlock x:Name="HeroCount" Text="0" FontFamily="{StaticResource Display}" FontSize="72" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock x:Name="HeroCountLabel" Text="sur 13 actifs" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Fiche technique -->
                            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="22,10">
                                <StackPanel>
                                    <Grid Margin="0,10,0,0"><TextBlock Text="CONFIGURATION DÉTECTÉE" Style="{StaticResource Overline}"/></Grid>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Carte graphique" Foreground="{StaticResource Muted}" FontSize="13"/>
                                        <TextBlock x:Name="DashGpu" Text="—" Style="{StaticResource Num}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,11"/>
                                    <Grid>
                                        <TextBlock Text="Limite de puissance" Foreground="{StaticResource Muted}" FontSize="13"/>
                                        <TextBlock x:Name="DashPower" Text="—" Style="{StaticResource Num}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,11"/>
                                    <Grid>
                                        <TextBlock Text="Température GPU" Foreground="{StaticResource Muted}" FontSize="13"/>
                                        <TextBlock x:Name="DashTemp" Text="—" Style="{StaticResource Num}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,11"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Fortnite" Foreground="{StaticResource Muted}" FontSize="13"/>
                                        <TextBlock x:Name="FnStatus" Text="…" Style="{StaticResource Num}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Catégories -->
                            <TextBlock Text="CATÉGORIES" Style="{StaticResource Overline}" Margin="2,22,0,4"/>
                            <Button x:Name="BtnOpenSystem" Style="{StaticResource BtnRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Système" FontFamily="{StaticResource Display}" FontSize="16"/>
                                        <TextBlock Text="Alimentation, Mode Jeu, planification GPU, minuteur, priorités CPU" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CntSystem" Text="" Style="{StaticResource Num}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="BtnOpenInput" Style="{StaticResource BtnRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Entrées &amp; réseau" FontFamily="{StaticResource Display}" FontSize="16"/>
                                        <TextBlock Text="Souris sans accélération, latence réseau" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CntInput" Text="" Style="{StaticResource Num}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="BtnOpenFn" Style="{StaticResource BtnRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Fortnite" FontFamily="{StaticResource Display}" FontSize="16"/>
                                        <TextBlock Text="Priorité CPU, GPU dédié, plein écran exclusif, graphismes" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CntFn" Text="" Style="{StaticResource Num}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="FnPath" Text="" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Réglages -->
                    <ScrollViewer x:Name="PageTweaks" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                        <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakTemplate}"/>
                    </ScrollViewer>

                    <!-- GPU -->
                    <ScrollViewer x:Name="PageGpu" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Padding="24">
                                <StackPanel>
                                    <TextBlock x:Name="GpuName" Text="Détection…" FontFamily="{StaticResource Display}" FontSize="24" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GpuDriver" Text="" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>

                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,16"/>
                                    <Grid><TextBlock Text="Puissance" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="TilePower" Text="—" Style="{StaticResource Num}"/></Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,11"/>
                                    <Grid><TextBlock Text="Fréquence boost max" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="TileClock" Text="—" Style="{StaticResource Num}"/></Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,11"/>
                                    <Grid><TextBlock Text="Température" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="TileTemp" Text="—" Style="{StaticResource Num}"/></Grid>

                                    <Grid Margin="0,22,0,0">
                                        <TextBlock Text="LIMITE DE PUISSANCE" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="BarPowerLabel" Text="" Style="{StaticResource Num}" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarPower" Style="{StaticResource Bar}" Margin="0,9,0,0"/>

                                    <TextBlock x:Name="GpuStatus" Text="" FontSize="12.5" Foreground="{StaticResource Warn}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                        <Button x:Name="BtnGpuBoost" Style="{StaticResource BtnPrimary}" Content="Booster le GPU" Padding="24,12"/>
                                        <Button x:Name="BtnGpuReset" Style="{StaticResource BtnGhost}" Content="Réglages d'origine" Padding="20,12" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Règle la limite de puissance au maximum et verrouille la fréquence minimale à 90 % du boost max (NVIDIA uniquement). Ce n'est pas un overclock avec tension : pour ça, utilise MSI Afterburner."
                                               FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="17"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Outils -->
                    <ScrollViewer x:Name="PageTools" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nettoyer les fichiers temporaires" FontFamily="{StaticResource Display}" FontSize="16"/>
                                        <TextBlock Text="Vide les dossiers Temp de l'utilisateur et de Windows." FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnClean" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Nettoyer" Padding="22,10"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tout restaurer" FontFamily="{StaticResource Display}" FontSize="16"/>
                                        <TextBlock Text="Annule tous les réglages appliqués et remet Windows dans son état d'origine." FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRestore" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Restaurer" Padding="22,10"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Barre d'actions -->
                <Grid x:Name="ActionBar" Grid.Row="2" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock x:Name="ProgressLabel" Text="Prêt" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <ProgressBar x:Name="Progress" Style="{StaticResource Bar}"/>
                    </StackPanel>
                    <Button x:Name="BtnApply" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Appliquer les réglages" Padding="30,12"/>
                </Grid>

                <!-- Journal -->
                <Border Grid.Row="3" Background="#08090A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Height="78">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#80858F"
                             FontFamily="{StaticResource Mono}" FontSize="11" Padding="12,8" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
