<Application x:Class="BlatjaTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Palette : noir chaud + un accent rouge -->
        <SolidColorBrush x:Key="Bg" Color="#09080A"/>
        <SolidColorBrush x:Key="SideBg" Color="#0C0B0E"/>
        <SolidColorBrush x:Key="PanelBg" Color="#111014"/>
        <SolidColorBrush x:Key="PanelHi" Color="#16141A"/>
        <SolidColorBrush x:Key="Line" Color="#211E25"/>
        <SolidColorBrush x:Key="LineHi" Color="#36313D"/>
        <SolidColorBrush x:Key="Text" Color="#EEECF0"/>
        <SolidColorBrush x:Key="Muted" Color="#8B8691"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B52"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#26FF3B52"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Good" Color="#4ADE80"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB020"/>
        <Color x:Key="AccentColor">#FF3B52</Color>
        <FontFamily x:Key="Body">pack://application:,,,/Fonts/#Poppins</FontFamily>
        <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Rajdhani</FontFamily>
        <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#Share Tech Mono</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Interrupteur -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#36313D">
                                <Border.Background><SolidColorBrush x:Name="Track" Color="#1C1A20"/></Border.Background>
                            </Border>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#8B8691" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="24,0,0,0" Duration="0:0:0.2">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Color" To="#FF3B52" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="4,0,0,0" Duration="0:0:0.2">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Color" To="#1C1A20" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boutons -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.Background><SolidColorBrush x:Name="Fill" Color="#FF3B52"/></Border.Background>
                            <Border.RenderTransform><ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#FF5C70" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#FF3B52" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.07"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.07"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background><SolidColorBrush x:Name="Fill" Color="#1A171E"/></Border.Background>
                            <Border.BorderBrush><SolidColorBrush x:Name="Edge" Color="#2B2730"/></Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#26222B" Duration="0:0:0.14"/>
                                    <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#4A4352" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#1A171E" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#2B2730" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnChrome" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <!-- Onglets (CPU / GPU / RAM) -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B8691"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="16,6" Margin="2,0">
                            <Border.Background><SolidColorBrush x:Name="Fill" Color="#00000000"/></Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#26222B" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#00000000" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastille de couleur -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Halo" Stroke="White" StrokeThickness="2" Opacity="0"/>
                            <Ellipse Margin="4" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Halo" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ de texte -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="#2B2730" Background="#0D0C10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B52"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#4A4352"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation latérale -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B8691"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10" Padding="14,10">
                                <Border.Background><SolidColorBrush x:Name="Fill" Color="#00000000"/></Border.Background>
                                <Grid>
                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="#6B6672"/>
                                </Grid>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="20" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Opacity="0" CornerRadius="0,2,2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#141217" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#00000000" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#1B181F" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#00000000" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barre de défilement fine -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2E2A34"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
