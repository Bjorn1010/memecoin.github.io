<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BlatjaTweaks</RootNamespace>
    <AssemblyName>Blatja Tweaks</AssemblyName>
    <Product>Blatja Tweaks</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <StartupObject>BlatjaTweaks.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Un seul .exe autonome : rien à installer sur le PC cible -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
