# Copie ce fichier en ".env" et remplis les valeurs.

# Mot de passe pour accéder au logiciel (obligatoire car il est hébergé en ligne)
APP_PASSWORD=change-moi

# Clé secrète pour chiffrer les sessions (mets une longue chaîne aléatoire)
SESSION_SECRET=change-moi-aussi

# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=

# Identifiants SMTP (optionnel : si définis ici, prennent le pas sur la page
# Profil de l'appli — pratique pour ne jamais avoir à taper le mot de passe
# dans l'interface). Pour Gmail : active la validation en 2 étapes puis crée
# un "mot de passe d'application" sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# Port du serveur
PORT=8787
