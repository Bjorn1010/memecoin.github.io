# Copie ce fichier en ".env" et remplis les valeurs.

# Clé secrète pour chiffrer les sessions (mets une longue chaîne aléatoire)
SESSION_SECRET=change-moi-aussi

# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=

# Base de données Turso (gratuite, persistante) : https://turso.tech
# Optionnel en local — sans ces variables, un fichier SQLite local est utilisé
# (server/data/app.db), pratique pour développer hors ligne. En production
# (Render), les deux sont nécessaires pour que les données survivent aux
# redéploiements.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port du serveur
PORT=8787
