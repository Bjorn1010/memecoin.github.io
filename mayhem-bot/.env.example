# Solana RPC endpoints. Free public endpoint by default — swap in a Helius/QuickNode/Triton
# key here later for lower latency and higher reliability, without touching any code.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Wallets tracked as "Mayhem". Comma-separated. Defaults to the officially documented
# Mayhem Mode Trading Agent wallet plus the high-activity wallet observed live on-chain.
MAYHEM_WALLETS=BwWK17cbHxwWBKZkUYvzxLcNQ1YVyaFezduWbtm2de6s,Gygj9QQby4j2jryqyqBHvLP7ctv2SaANgh4sCb69BUpA

# HTTP port for the dashboard API + WebSocket push
PORT=8787

# SQLite file (created automatically)
DB_PATH=./data/mayhem-bot.db

# --- alx-agent only (src/ai/) — the separate AI reasoning bot, not the main mayhem-bot ---
# Free Groq API key (no card required): https://console.groq.com/keys
# Without it, the agent watches tokens but never makes a decision.
GROQ_API_KEY=
