# =============================================================================
# Copy to .env and edit. `.env` is gitignored; never commit it.
#
# Every value below changes what the bot trades or how much it risks. None of
# them are tuned: they are conservative starting points chosen before any data
# existed. Recalibrate them from `npm run report`, not from intuition.
# =============================================================================

# --- connectivity ------------------------------------------------------------
# A free Helius/QuickNode/Triton key works. The public endpoint below is enough
# to run --observe, but it rate limits aggressively and will not sustain --live.
# The URL often contains an API key: it is redacted in logs, but treat the whole
# .env file as a secret.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com
COMMITMENT=confirmed

# --- RPC budget ---------------------------------------------------------------
# Set these to what your plan actually allows. Every call in the bot passes
# through a priority token bucket built from them.
RPC_REQUESTS_PER_SECOND=8
RPC_BURST_CAPACITY=20
# Your provider's cap on concurrent accountSubscribe. Each watched pool needs 3.
MAX_SUBSCRIPTIONS=90

# --- capital and risk (all amounts in SOL) ------------------------------------
MAX_TRADE_SIZE=0.25
MAX_TOKEN_EXPOSURE=0.02
MAX_IN_FLIGHT_TX=1
MAX_DAILY_LOSS=0.15
# Native SOL kept back for fees and never traded.
FEE_RESERVE=0.02
# Below this a trade is dust: the fixed costs dwarf it.
MIN_TRADE_SIZE=0.01

# --- profitability bars -------------------------------------------------------
# Profit kept if the transaction lands, on top of every cost. This is the single
# most important number in the file and the most likely to be wrong at first.
MIN_PROFIT=0.0008
# Expected value must clear this, not merely zero, to absorb model error.
MIN_EXPECTED_VALUE=0.0002

# --- freshness ----------------------------------------------------------------
# These bound RPC-primed state only; state covered by a live subscription is
# current by definition. See src/search/freshness.ts for why.
MAX_STATE_AGE_SLOTS=4
MAX_STATE_AGE_MS=1500
# Feed silence longer than this invalidates every quote at once.
FEED_STALL_MS=30000

# --- compute and fees ---------------------------------------------------------
COMPUTE_UNIT_MARGIN_BPS=2000
MAX_COMPUTE_UNIT_LIMIT=400000
# Micro-lamports per compute unit.
MAX_COMPUTE_UNIT_PRICE=50000

# --- inclusion ----------------------------------------------------------------
# Off by default. Read the Jito section of the README before turning it on: a
# bundle that fails is never included and therefore free, which changes the
# economics substantially, but it is a different transport with its own limits.
USE_JITO=false
# Required when USE_JITO=true. No default is provided on purpose.
# JITO_BLOCK_ENGINE_URL=https://<region>.mainnet.block-engine.jito.wtf
MIN_TIP=0.00001
MAX_TIP=0.002
MAX_TIP_SHARE_BPS=3000

# --- screener -----------------------------------------------------------------
MAX_WATCHED_POOLS=20
SCREENER_INTERVAL_MS=60000
SCREENER_ENTRY_MARGIN=0.25
SCREENER_MIN_SCORE=0.1
SCREENER_MIN_RESIDENCY_MS=600000
SCREENER_COOLDOWN_MS=1800000

# --- token policy -------------------------------------------------------------
REJECT_FREEZE_AUTHORITY=true
REJECT_MINT_AUTHORITY=false
MIN_POOL_LIQUIDITY=0.5
MIN_POOL_AGE_MS=600000
BLACKLIST_MINTS=
WHITELIST_MINTS=

# --- land rate ----------------------------------------------------------------
# The prior is deliberately pessimistic: optimism has to be earned with evidence.
LAND_RATE_PRIOR_STRENGTH=20
LAND_RATE_PRIOR_SUCCESS_SHARE=0.05
LAND_RATE_MIN_SAMPLES=25

# --- execution ----------------------------------------------------------------
LEG1_TOLERANCE_BPS=0
OPPORTUNITY_LOCK_TIMEOUT_MS=30000

# --- storage ------------------------------------------------------------------
DATA_DIR=./data

# --- LIVE TRADING -------------------------------------------------------------
# All three must be set for `npm run live` to start. Leave them alone until the
# "Before going live" checklist in the README is genuinely satisfied.
LIVE_TRADING=false
LIVE_CONFIRMATION=
# Path to a DEDICATED wallet holding only what you can afford to lose.
# WALLET_KEYPAIR_PATH=./wallet.json

# Public key only, no secret. Paper mode simulates against this account's real
# balances; without it a paper simulation fails for lack of funds and measures
# nothing. Safe to set: a public key cannot spend anything.
# WALLET_PUBLIC_KEY=
